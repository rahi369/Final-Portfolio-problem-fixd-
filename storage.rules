rules_version = '2';

// Firebase Storage Security Rules for Vexora Studio (portfolio-website-for-rahi)
// Deploy in Firebase Console -> Storage -> Rules
service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'rahihumaun369@gmail.com';
    }

    function isAllowedAssetType() {
      return request.resource != null
        && request.resource.contentType != null
        && (
          request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif)')
          || request.resource.contentType == 'application/pdf'
        );
    }

    // Portfolio public images & CV PDFs
    match /portfolio-assets/{allPaths=**} {
      // Public visitors can load published portfolio images and downloadable CVs
      allow read: if true;

      // Only the verified portfolio owner can upload, overwrite, or delete assets
      allow create, update: if isVerifiedAdmin()
        && isAllowedAssetType()
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024;

      allow delete: if isVerifiedAdmin();
    }

    // Default deny everything outside portfolio-assets
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
